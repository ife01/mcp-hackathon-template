# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop, Bob, MCP Inspector)
# "streamable-http" — remote HTTP server (containers, cloud deploys, wxO)
#
# On a cloud host (IBM Code Engine, cloud.gov) leave this as stdio: server.py
# automatically switches to HTTP when the platform injects a port (PORT or
# DATABRICKS_APP_PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when MCP_TRANSPORT=streamable-http) ───────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Socrata / CDC API ────────────────────────────────────────────────────────
# Optional free app token — raises rate limits from ~1 req/s to ~10 req/s.
# Register at https://dev.socrata.com/foundry/
# SOCRATA_APP_TOKEN=your_token_here

# ─── Cache & Timeouts ─────────────────────────────────────────────────────────
# CACHE_TTL_SECONDS=3600
# HTTP_TIMEOUT_SECONDS=6
# HTTP_TOTAL_TIMEOUT_SECONDS=20

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# Future live wxO integration only (offline checks do not read these).
# Match the chosen IBM authentication method before configuring a runner.
# WXO_INSTANCE_URL=https://your-sandbox-service-url
# WXO_AGENT_ID=your-agent-id
# WXO_AUTH_TYPE=ibm_iam
# WXO_API_KEY=store-only-in-your-local-ignored-env-file

# Phoenix + LangChain evaluation (eval/phoenix/README.md)
# Select openai (default) or digital_gateway.
# MODEL_PROVIDER=openai
# Required only for REAL model runs; dry-runs and scripted verification need none.
# These legacy USAI_* names can configure any compatible Chat Completions gateway.
# Use the exact API base from your provider/admin, never a chat website or wxO URL.
# USAI_BASE_URL=https://your-gateway.example/api/v1
# USAI_API_KEY=replace-with-your-local-secret
# AGENT_MODEL=replace-with-exact-agent-model-or-deployment-id
# JUDGE_MODEL=replace-with-exact-judge-model-or-deployment-id
# If BASE_URL is an origin, this path is appended once. A full /v1 base is preserved.
# USAI_API_PATH=/api/v1
# Optional: a separate compatible judge endpoint/key; otherwise USAI_* is reused.
# JUDGE_BASE_URL=https://your-judge-gateway.example/v1
# JUDGE_API_KEY=replace-with-your-local-judge-secret
# MODEL_TIMEOUT_SECONDS=90
# AGENT_RUN_TIMEOUT_SECONDS=180
# Local Phoenix needs no Phoenix API key. For hosted/authenticated Phoenix only:
# PHOENIX_ENDPOINT=http://localhost:6006
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_API_KEY=replace-only-if-your-phoenix-server-requires-it

# Organizational Azure Digital Gateway: use this block instead of USAI_*.
# Keep all actual credentials in the ignored root .env.
# MODEL_PROVIDER=digital_gateway
# AZURE_TENANT_ID=replace-with-tenant-id
# AZURE_CLIENT_ID=replace-with-client-id
# AZURE_CLIENT_SECRET=replace-with-client-secret
# DGW_OPENAI_ENDPOINT=https://gateway.example/your-prefix
# DGW_OPENAI_API_VERSION=replace-with-supported-api-version
# DGW_SUBSCRIPTION_KEY=replace-with-subscription-key
# DGW_SCOPE=replace-with-token-scope
# AGENT_MODEL=model-a
# JUDGE_MODEL=model-b
# DGW_MODEL_DEPLOYMENTS={"model-a":"agent-deployment","model-b":"judge-deployment"}
# Optional explicit role deployment overrides:
# DGW_AGENT_DEPLOYMENT=agent-deployment
# DGW_JUDGE_DEPLOYMENT=judge-deployment
