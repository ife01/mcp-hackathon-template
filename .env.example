# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop, Bob, MCP Inspector)
# "streamable-http" — remote HTTP server (containers, cloud deploys, wxO)
#
# On a cloud host (IBM Code Engine, cloud.gov) leave this as stdio: server.py
# automatically switches to HTTP when the platform injects a port (PORT or
# DATABRICKS_APP_PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when MCP_TRANSPORT=streamable-http) ───────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Socrata / CDC API ────────────────────────────────────────────────────────
# Optional free app token — raises rate limits from ~1 req/s to ~10 req/s.
# Register at https://dev.socrata.com/foundry/
# SOCRATA_APP_TOKEN=your_token_here

# ─── Cache & Timeouts ─────────────────────────────────────────────────────────
# CACHE_TTL_SECONDS=3600
# HTTP_TIMEOUT_SECONDS=15

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ─── Phoenix Evaluation Harness (eval/phoenix/) ───────────────────────────────
# Required for running LLM-as-judge evaluations. NOT needed to run the MCP server.
# The harness uses an OpenAI-compatible Chat Completions endpoint with Bearer auth.
#
# IMPORTANT: A wxO credentials URL/key is NOT a model API endpoint.
# Use the direct model API base URL (e.g. from your USAI gateway or provider).
# The code appends /api/v1 to this base URL automatically.
#
# USAI_BASE_URL=https://your-model-gateway.example.com
# USAI_API_KEY=your_api_key_here
#
# Agent model (tool-calling capable; tested against the benchmark):
# AGENT_MODEL=your_agent_model_id
#
# Judge model (keep distinct from agent to reduce self-preference bias;
# preferably a stronger or different model):
# JUDGE_MODEL=your_judge_model_id
#
# Optional: separate judge provider (omit to reuse USAI_* above)
# JUDGE_BASE_URL=https://separate-judge-gateway.example.com
# JUDGE_API_KEY=your_judge_api_key_here
#
# Optional: hosted Phoenix (omit for local Phoenix at localhost:6006)
# PHOENIX_ENDPOINT=https://your-phoenix.example.com
# PHOENIX_COLLECTOR_ENDPOINT=https://your-phoenix.example.com
# PHOENIX_API_KEY=your_phoenix_api_key_here
