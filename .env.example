# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop, Bob, MCP Inspector)
# "streamable-http" — remote HTTP server (containers, cloud deploys, wxO)
#
# On a cloud host (IBM Code Engine, cloud.gov) leave this as stdio: server.py
# automatically switches to HTTP when the platform injects a port (PORT or
# DATABRICKS_APP_PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when MCP_TRANSPORT=streamable-http) ───────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Socrata / CDC API ────────────────────────────────────────────────────────
# Optional free app token — raises rate limits from ~1 req/s to ~10 req/s.
# Register at https://dev.socrata.com/foundry/
# SOCRATA_APP_TOKEN=your_token_here

# ─── Cache & Timeouts ─────────────────────────────────────────────────────────
# CACHE_TTL_SECONDS=3600
# HTTP_TIMEOUT_SECONDS=15

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
