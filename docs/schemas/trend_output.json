{
  "$defs": {
    "Pathogen": {
      "description": "The three respiratory pathogens tracked by this server.",
      "enum": [
        "influenza",
        "covid19",
        "rsv"
      ],
      "title": "Pathogen",
      "type": "string"
    },
    "Provenance": {
      "description": "Data lineage for a single signal/series.\n\nAttached once per series (not per row) to keep tool outputs compact.",
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_name": {
          "title": "Dataset Name",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "latest_week_ending": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Week Ending"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_last_updated": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Last Updated"
        },
        "geography_level": {
          "enum": [
            "national",
            "state",
            "hhs_region",
            "site_aggregate"
          ],
          "title": "Geography Level",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "dataset_id",
        "dataset_name",
        "url",
        "latest_week_ending",
        "retrieved_at",
        "geography_level"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Signal": {
      "description": "The three surveillance signal types available.",
      "enum": [
        "hospital_admissions",
        "wastewater",
        "test_positivity"
      ],
      "title": "Signal",
      "type": "string"
    },
    "TrendSummary": {
      "description": "Serialisable version of TrendResult for tool outputs.",
      "properties": {
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "direction": {
          "description": "increasing | stable | decreasing | insufficient_data",
          "title": "Direction",
          "type": "string"
        },
        "pct_change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Relative change as a decimal (0.15 = 15%). None when unavailable.",
          "title": "Pct Change"
        },
        "abs_change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Absolute change in the signal's native unit.",
          "title": "Abs Change"
        },
        "window_weeks": {
          "description": "Number of recent observation slots inspected (at most four).",
          "title": "Window Weeks",
          "type": "integer"
        },
        "method": {
          "description": "Method identifier (e.g. '2w_vs_prior_2w').",
          "title": "Method",
          "type": "string"
        },
        "basis": {
          "description": "server_heuristic \u2014 NOT an official CDC classification. Use official_level in WeeklyObservation for authoritative CDC levels.",
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "direction",
        "window_weeks",
        "method",
        "basis"
      ],
      "title": "TrendSummary",
      "type": "object"
    },
    "WeeklyObservation": {
      "description": "A single weekly data point for a jurisdiction/pathogen/signal combination.\n\nProvenance is NOT embedded here \u2014 it lives on the parent container.",
      "properties": {
        "jurisdiction": {
          "title": "Jurisdiction",
          "type": "string"
        },
        "week_ending": {
          "format": "date",
          "title": "Week Ending",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "admissions_per_100k",
            "admissions_count",
            "percent_positive",
            "wval"
          ],
          "title": "Unit",
          "type": "string"
        },
        "official_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Level"
        },
        "derived_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived Level"
        },
        "aggregation_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Method"
        },
        "raw_count": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Count"
        },
        "coverage": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage"
        }
      },
      "required": [
        "jurisdiction",
        "week_ending",
        "value",
        "unit"
      ],
      "title": "WeeklyObservation",
      "type": "object"
    }
  },
  "description": "Output for assess_trend.\n\nUSE WHEN: You need to characterise whether a signal is rising, stable, or\nfalling over recent weeks. Includes the weekly series so an agent can cite\nspecific values.",
  "properties": {
    "jurisdiction": {
      "title": "Jurisdiction",
      "type": "string"
    },
    "pathogen": {
      "$ref": "#/$defs/Pathogen"
    },
    "signal": {
      "$ref": "#/$defs/Signal"
    },
    "series": {
      "description": "Weekly observations in ascending date order.",
      "items": {
        "$ref": "#/$defs/WeeklyObservation"
      },
      "title": "Series",
      "type": "array"
    },
    "trend": {
      "$ref": "#/$defs/TrendSummary"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "summary": {
      "description": "1\u20132 sentence plain-English summary.",
      "title": "Summary",
      "type": "string"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    }
  },
  "required": [
    "jurisdiction",
    "pathogen",
    "signal",
    "series",
    "trend",
    "provenance",
    "summary"
  ],
  "title": "TrendOutput",
  "type": "object"
}
